<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bootcamp</groupId>
        <artifactId>bootcamp-parent-pom</artifactId>
        <version>2.2.0</version>
        <relativePath/>
    </parent>

    <artifactId>customer-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>customer-service</name>
    <description>
        Gestion de clientes del banco (personal/empresarial): CRUD reactivo sobre customerdb.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- spring-retry + starter-aop: sin estos dos, spring.cloud.config.retry.enabled no
             hace nada (el interceptor de reintentos no se teje) - version manejada por los BOM
             heredados (spring-cloud-dependencies / spring-boot-starter-parent). -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Productor de eventos a Kafka (Fase III, D5 relectura estricta: un microservicio
             NUEVO no puede llamarnos por REST, se entera de los clientes por evento). spring-kafka
             clasico (KafkaTemplate), no reactor-kafka - mismo criterio que el resto del proyecto:
             el punto de publicacion es un efecto secundario best-effort tras guardar en Mongo, no
             necesita ser parte del pipeline Reactor (igual patron que los jobs @Scheduled).
             OJO Spring Boot 4: el artefacto crudo org.springframework.kafka:spring-kafka trae
             KafkaTemplate pero NO la autoconfiguracion (KafkaAutoConfiguration se movio fuera de
             spring-boot-autoconfigure); hay que traer el starter spring-boot-starter-kafka para
             que Boot registre el bean. Version manejada por el BOM de spring-boot-starter-parent,
             ya heredado. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- Contrato OpenAPI (Requerimiento no funcional Parte I/III) + Swagger UI: generado a
             partir de los controladores REST reales via @OpenAPIDefinition en la clase principal
             - /v3/api-docs y /swagger-ui.html. Version gestionada en bootcamp-parent-pom. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- reactor-test ya viene heredado de bootcamp-parent-pom -->
        <!-- Spring Boot 4 modularizo el test-autoconfigure monolitico por tecnologia: @WebFluxTest
             quedo en este artefacto aparte, spring-boot-starter-test ya no lo trae incluido. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>customer-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
